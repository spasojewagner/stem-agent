# Copy to .env and fill in. Never commit .env.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, local Ollama at http://localhost:11434/v1).
STEM_API_BASE=https://api.groq.com/openai/v1

# Each model has its own free-tier quota, so the work is spread across them.
STEM_MODEL_DEVELOP=openai/gpt-oss-120b
STEM_MODEL_ACT=llama-3.3-70b-versatile
STEM_MODEL_FAST=llama-3.1-8b-instant
STEM_MODEL_SEARCH=openai/gpt-oss-20b

# Hard stop for one command, in tokens. The run saves progress and can be resumed.
STEM_TOKEN_BUDGET=400000

# Web tools for the developmental process (search runs server-side at the provider).
STEM_WEB=1
STEM_WEB_ALLOW=en.wikipedia.org,docs.python.org

# Seconds a genome-authored tool may run per call.
STEM_TOOL_TIMEOUT=30
